{
	"name": "@file/global",
	"version": "0.0.1",
	"main": "dist/index",
	"types": "dist/index",
	"private": true,
	"description": "",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "pnpm exec tsc -p tsconfig.build.json",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\"",
		"test": "pnpm exec jest --passWithNoTests",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "pnpm exec jest --config ./test/jest-e2e.json --passWithNoTests",
		"lint:fix": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix"
	},
	"dependencies": {},
	"devDependencies": {
		"@file/tsconfig": "workspace:*"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
