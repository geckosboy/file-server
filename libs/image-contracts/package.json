{
	"name": "@file/image-contracts",
	"version": "0.0.1",
	"main": "dist/index",
	"types": "dist/index",
	"private": true,
	"description": "",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "pnpm exec tsc -p tsconfig.build.json",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "pnpm exec eslint \"src/**/*.ts\"",
		"lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix",
		"test": "pnpm exec jest --passWithNoTests",
		"test:e2e": "pnpm exec jest --config ./test/jest-e2e.json --passWithNoTests"
	},
	"dependencies": {
		"@nestjs/mapped-types": "^2.1.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1"
	},
	"devDependencies": {
		"@file/tsconfig": "workspace:*"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
