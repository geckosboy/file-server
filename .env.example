# 루트 환경 파일은 Prisma CLI(db:migrate, db:generate 등)에서만 사용합니다.
# 실행 중인 앱은 이 파일을 자동으로 읽지 않으므로 각 apps/<app>/.env.local을 설정하세요.

# Prisma가 접속할 PostgreSQL URL입니다.
# storage, resize, cache, telemetry-api의 DATABASE_URL과 같은 DB를 가리켜야 합니다.
DATABASE_URL="postgresql://file_server:file_server@127.0.0.1:5432/file_server"
