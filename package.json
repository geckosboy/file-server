{
	"name": "file-server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"packageManager": "yarn@4.5.0",
	"license": "MIT",
	"workspaces": [
		"libs/*",
		"apps/*"
	],
	"scripts": {
		"file:storage": "yarn workspace @file/storage",
		"file:resize": "yarn workspace @file/resize",
		"file:cache": "yarn workspace @file/cache",
		"file:global": "yarn workspace @file/global",
		"all:build": "yarn workspaces foreach -A -p run build",
		"all:lint": "eslint \"{apps,libs}/**/*.ts\"",
		"all:lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
		"all:test": "yarn file:storage test && yarn file:resize test && yarn file:cache test && yarn file:global test"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/core": "^11.1.27",
		"@nestjs/testing": "^11.1.27",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/mime-types": "^2.1.4",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.17.24",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.61.1",
		"@typescript-eslint/parser": "^8.61.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^16.5.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.61.1",
		"webpack": "^5.104.0"
	}
}
