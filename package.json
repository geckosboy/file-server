{
	"name": "file-server",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": "10.15.0"
	},
	"license": "MIT",
	"workspaces": [
		"libs/*",
		"apps/*"
	],
	"scripts": {
		"file:storage": "pnpm --filter @file/storage",
		"file:resize": "pnpm --filter @file/resize",
		"file:cache": "pnpm --filter @file/cache",
		"file:telemetry-api": "pnpm --filter @file/telemetry-api",
		"file:lifecycle-consumer-tester": "pnpm --filter @file/lifecycle-consumer-tester",
		"file:admin-web": "pnpm --filter @file/admin-web",
		"all:build": "turbo run build",
		"all:lint": "turbo run lint",
		"all:lint:fix": "turbo run lint:fix",
		"all:test": "turbo run test",
		"all:test:e2e": "pnpm test:component:e2e",
		"test:component:e2e": "turbo run test:e2e --filter=@file/storage --filter=@file/resize --filter=@file/cache --filter=@file/telemetry-api",
		"test:system:e2e": "node scripts/system-e2e.mjs",
		"test:image-lifecycle:system:e2e": "node scripts/image-lifecycle-system-e2e.mjs",
		"test:kafka:acl:e2e": "scripts/kafka/test/kafka-acl-isolation.e2e.sh",
		"integration:travel-cloud:up": "node scripts/travel-cloud-integration.mjs up",
		"integration:travel-cloud:provision": "node scripts/travel-cloud-integration.mjs provision",
		"integration:travel-cloud:test": "node scripts/travel-cloud-integration.mjs test",
		"integration:travel-cloud:verify": "node scripts/travel-cloud-integration.mjs verify",
		"integration:travel-cloud:status": "node scripts/travel-cloud-integration.mjs status",
		"integration:travel-cloud:logs": "node scripts/travel-cloud-integration.mjs logs",
		"integration:travel-cloud:down": "node scripts/travel-cloud-integration.mjs down",
		"docker:build": "docker build -f docker/apps/Dockerfile.storage -t file-server/storage:local . && docker build -f docker/apps/Dockerfile.resize -t file-server/resize:local . && docker build -f docker/apps/Dockerfile.cache -t file-server/cache:local .",
		"test:docker:smoke": "node scripts/docker-smoke.mjs",
		"typecheck:ts7": "node scripts/typecheck-ts7.mjs",
		"dev:files": "turbo run start:dev --filter=@file/storage --filter=@file/resize --filter=@file/cache",
		"dev:admin": "turbo run start:dev --filter=@file/telemetry-api  --filter=@file/admin-web",
		"dev:lc-tester": "turbo run start:dev --filter=@file/lifecycle-consumer-tester",
		"db:generate": "prisma generate",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:backfill:image-assets": "node scripts/image-asset-backfill.mjs",
		"db:studio": "prisma studio",
		"kafka:topics:dev": "scripts/kafka/ensure-image-topics.sh dev",
		"kafka:topics:prod": "scripts/kafka/ensure-image-topics.sh prod",
		"kafka:lifecycle:consume": "scripts/kafka/consume-image-lifecycle-example.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@nestjs/common": "^11.1.27",
		"@nestjs/core": "^11.1.27",
		"@nestjs/testing": "^11.1.27",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/mime-types": "^2.1.4",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.17.24",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.3",
		"@typescript-eslint/eslint-plugin": "^8.61.1",
		"@typescript-eslint/parser": "^8.61.1",
		"dotenv": "^17.4.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^16.5.0",
		"jest": "^29.7.0",
		"kafkajs": "^2.2.4",
		"prettier": "^3.4.2",
		"prisma": "7.8.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"turbo": "^2.10.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.61.1",
		"webpack": "^5.108.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp"
		],
		"overrides": {
			"@hono/node-server": "1.19.13",
			"postcss": "8.5.16"
		}
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.8.0",
		"@prisma/client": "7.8.0",
		"pg": "^8.22.0"
	}
}
