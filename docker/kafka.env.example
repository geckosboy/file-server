# Kafka 4.x + KRaft production cluster example.
# Never commit the real passwords or PKCS12 files referenced below.

KAFKA_VERSION=4.3.1
KAFKA_COMPOSE_PROJECT_NAME=kafka

# 한 번 운영을 시작한 클러스터에서는 CLUSTER_ID를 바꾸지 마세요. 기존 volume과 묶이는 값입니다.
KAFKA_CLUSTER_ID=QGC1ZwwXR1CPFacYpEvEZg
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093

# 로컬: localhost / 실서버: 실제 DNS 또는 고정 IP
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
KAFKA_EXTERNAL_ADVERTISED_PORT=9094
KAFKA_INTERNAL_HOST_PORT=9092
KAFKA_EXTERNAL_HOST_PORT=9094

# 개발 편의는 true, 실서버에서 topic을 명시적으로 관리하려면 false로 바꾸세요.
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_NUM_PARTITIONS=3

# 단일 브로커 값입니다. 3브로커 이상으로 확장하면 replication factor/min ISR를 같이 올리세요.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1

KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

KAFKA_UI_VERSION=latest
KAFKA_UI_HOST_PORT=8080
KAFKA_UI_CLUSTER_NAME=file_server_kafka

# 아래 값은 Kafka 컨테이너가 아니라 storage/resize/cache 앱에서 읽는 접속값입니다.
# 앱을 호스트에서 직접 실행하면 localhost:9094, 같은 Docker 네트워크에서 실행하면 kafka:9092를 쓰세요.
KAFKA_CLIENT_BROKERS=localhost:9094
KAFKA_SSL_ENABLED=true
KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=file_server_admin
KAFKA_SASL_PASSWORD=replace-with-secret

# Production brokers require these values and the mounted files:
# - kafka-broker-{1,2,3}.keystore.p12
# - kafka.truststore.p12
# - broker-admin.properties (SASL_PLAINTEXT admin config for internal CLI/health)
KAFKA_TLS_SECRETS_DIR=./docker/kafka-secrets
KAFKA_BROKER_ADMIN_PASSWORD=replace-with-distinct-secret
KAFKA_ADMIN_PASSWORD=replace-with-distinct-secret
KAFKA_SSL_KEYSTORE_PASSWORD=replace-with-secret
KAFKA_SSL_KEY_PASSWORD=replace-with-secret
KAFKA_SSL_TRUSTSTORE_PASSWORD=replace-with-secret

# Runtime lifecycle topic provisioning uses the admin principal. Production
# defaults to enabled; set explicitly so deployment intent is reviewable.
LIFECYCLE_TOPIC_PROVISIONING_ENABLED=true
LIFECYCLE_TOPIC_ADMIN_BROKERS=localhost:19092,localhost:19093,localhost:19094
LIFECYCLE_CLIENT_TOPIC_PARTITIONS=6
LIFECYCLE_CLIENT_TOPIC_REPLICATION_FACTOR=3
LIFECYCLE_CLIENT_TOPIC_MIN_ISR=2

# apache/kafka 이미지의 기본 실행 사용자입니다. named volume 권한 초기화에 사용합니다.
KAFKA_CONTAINER_UID=1000
KAFKA_CONTAINER_GID=1000

# container_name을 유지하되 kafka/kafka-ui 이름 충돌이 나면 이 값들만 바꾸세요.
# KAFKA_CONTAINER_NAME=kafka
# KAFKA_UI_CONTAINER_NAME=kafka-ui
KAFKA_UI_USERNAME=admin
SPRING_SECURITY_USER_PASSWORD=kafka_ui_pw
