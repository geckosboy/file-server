FROM node:20-alpine AS ts-compiler
WORKDIR /usr/index
COPY ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml ../../tsconfig.json ../../prisma.config.ts ./
COPY ../../apps ./apps
COPY ../../libs ./libs
COPY ../../prisma ./prisma
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm --filter @file/cache build

FROM node:20-alpine AS prod-deps
WORKDIR /usr/index
COPY --from=ts-compiler /usr/index ./
RUN corepack enable && CI=true pnpm prune --prod

FROM keymetrics/pm2:18-alpine
WORKDIR /usr/index
ENV TZ=Asia/Seoul
ENV NODE_ENV=production
ENV HOST=0.0.0.0
COPY --from=prod-deps /usr/index ./
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /usr/index
USER app

CMD ["pm2-runtime", "start", "/usr/index/apps/cache/ecosystem.config.js", "--env", "production"]
