# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.15.0

FROM node:${NODE_VERSION}-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /usr/index

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json prisma.config.ts ./
COPY apps/resize ./apps/resize
COPY libs ./libs
COPY prisma ./prisma

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
	pnpm install --frozen-lockfile
RUN pnpm db:generate && pnpm turbo run build --filter=@file/resize
RUN pnpm --filter @file/resize --prod deploy --legacy /opt/app \
	&& cp -R apps/resize/dist /opt/app/dist \
	&& prisma_source="$(find node_modules/.pnpm -path '*/node_modules/.prisma/client' -type d -print -quit)" \
	&& prisma_package="$(find /opt/app/node_modules/.pnpm -path '*/node_modules/@prisma/client' -type d -print -quit)" \
	&& test -n "$prisma_source" -a -n "$prisma_package" \
	&& prisma_node_modules="$(dirname "$(dirname "$prisma_package")")" \
	&& mkdir -p "$prisma_node_modules/.prisma" \
	&& cp -R "$prisma_source" "$prisma_node_modules/.prisma/client" \
	&& find /opt/app -type f -name '.env*' -delete \
	&& rm -rf /opt/app/src /opt/app/test

FROM node:${NODE_VERSION}-alpine AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV TZ=Asia/Seoul
WORKDIR /usr/index/apps/resize

COPY --from=build --chown=node:node /opt/app ./

USER node
EXPOSE 3031
CMD ["node", "dist/apps/resize/src/main.js"]
