# Travel Cloud 통합 하네스 입력 설정입니다.
# 운영 secret은 포함하지 않습니다. pnpm 명령 실행 전에 source 하세요.
#   set -a && source docker/travel-cloud/harness.env.example && set +a

# Docker Compose project 이름입니다. cleanup이 삭제할 resource label 경계이기도 합니다.
TRAVEL_CLOUD_INTEGRATION_PROJECT=file-server-travel-cloud

# Nginx reverse proxy가 호스트에 공개할 포트입니다.
TRAVEL_CLOUD_PROXY_HOST_PORT=18088

# 생성되는 TRAVEL_FILE_SERVER_BASE_URL에 기록할 hostname입니다.
# 호스트 프로세스는 127.0.0.1, 다른 컨테이너는 host.docker.internal을 사용합니다.
TRAVEL_CLOUD_PROXY_ADVERTISED_HOST=127.0.0.1

# provisioning script만 사용하는 localhost 전용 telemetry-api 제어면 포트입니다.
TRAVEL_CLOUD_TELEMETRY_HOST_PORT=13100

# Kafka external SASL_PLAINTEXT listener가 호스트에 공개할 포트입니다.
TRAVEL_CLOUD_KAFKA_HOST_PORT=39094

# Travel Cloud consumer에게 Kafka metadata로 전달할 broker hostname입니다.
# 호스트 프로세스는 localhost, 다른 컨테이너는 host.docker.internal을 사용합니다.
TRAVEL_CLOUD_KAFKA_ADVERTISED_HOST=localhost

# 이 disposable 단일 broker 하네스에서만 사용하는 KRaft cluster ID입니다.
# 기존 Kafka data directory를 유지하는 동안에는 바꾸면 안 됩니다.
TRAVEL_CLOUD_KAFKA_CLUSTER_ID=VHJhdmVsQ2xvdWRGaWxlU2Vydg

# Docker image tag입니다. 의도적인 image upgrade를 검증할 때만 변경합니다.
POSTGRES_VERSION=18-alpine
KAFKA_VERSION=4.3.1
NGINX_VERSION=alpine
