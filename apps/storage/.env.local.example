# apps/storage/.env.local로 복사해서 사용합니다.
# filesystem 원본, authoritative metadata, lifecycle outbox, variant job과 reconciliation을 담당합니다.

# 실행 환경입니다. production에서는 테스트 전용 failpoint가 fail-closed로 동작합니다.
NODE_ENV=development
# HTTP 서버 bind 주소입니다. 컨테이너에서는 0.0.0.0을 사용하세요.
HOST=127.0.0.1
# storage 앱의 HTTP 포트입니다.
PORT=3032
# CORS 허용 origin의 쉼표 구분 목록입니다.
ORIGIN_LIST_STR=http://localhost:3000,http://127.0.0.1:3000

# Kafka broker의 쉼표 구분 목록입니다. lifecycle, variant job, cache invalidation에 사용합니다.
KAFKA_CLIENT_BROKERS=localhost:9094
# TLS 사용 여부입니다. true이면 읽을 수 있는 CA 파일 경로가 필요합니다.
# KAFKA_SSL_ENABLED=true
# Kafka broker 인증서를 검증할 PEM CA 파일 경로입니다.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
# SASL 방식입니다: plain, scram-sha-256, scram-sha-512 중 하나입니다.
# KAFKA_SASL_MECHANISM=plain
# storage 전용 Kafka principal입니다. 필요한 topic 권한만 부여하세요.
# KAFKA_SASL_USERNAME=file_server_storage
# storage principal 비밀번호입니다. 실제 값을 저장소에 커밋하지 마세요.
# KAFKA_SASL_PASSWORD=replace-with-secret

# authoritative image metadata, API key, outbox를 저장할 PostgreSQL URL입니다.
# root Prisma CLI 및 resize/cache/telemetry-api와 같은 DB를 가리켜야 합니다.
DATABASE_URL=postgresql://file_server:file_server@127.0.0.1:5432/file_server
# API key hash 검증용 pepper입니다. 발급 시 사용한 값 및 모든 서버 앱과 같아야 합니다.
# 변경하면 기존 API key를 검증할 수 없으므로 계획된 rotation 없이 바꾸면 안 됩니다.
CLIENT_API_KEY_PEPPER=dev-local-pepper
# 이미지 변경/삭제 시 직접 호환 호출할 cache 앱 base URL입니다.
# replica 전체 무효화의 authoritative 경로는 아래 Kafka invalidation topic입니다.
CACHE_SERVER=http://127.0.0.1:3030
# storage/resize/cache 사이 내부 호출을 인증하는 공유 key입니다. 외부에 노출하지 마세요.
INTERNAL_API_KEY=dev-internal-key
# readiness에서 DB/Kafka/cache/storage probe 한 번을 기다리는 최대 시간(ms)입니다.
HEALTH_PROBE_TIMEOUT_MS=2000
# readiness probe 결과를 재사용하는 시간(ms)입니다.
HEALTH_PROBE_CACHE_TTL_MS=1000
# 업로드/metadata 검사에서 허용할 입력 이미지의 최대 총 pixel 수입니다.
IMAGE_MAX_INPUT_PIXELS=40000000
# 이미지 처리 결과로 허용할 최대 byte 수입니다.
IMAGE_MAX_OUTPUT_BYTES=20971520
# 프로세스당 Sharp 작업 동시성 상한입니다. CPU/RSS 용량에 맞춰 조정하세요.
SHARP_CONCURRENCY=2

# ── Lifecycle/cache-invalidation outbox ──────────────────────────────────────
# 미발행 outbox를 lease하여 Kafka로 전달하는 worker 주기(ms)입니다. 0이면 interval publisher를 끕니다.
LIFECYCLE_OUTBOX_PUBLISH_INTERVAL_MS=5000
# publisher 한 번이 lease/전달할 outbox 최대 개수입니다.
LIFECYCLE_OUTBOX_PUBLISH_BATCH_SIZE=25
# 다른 replica가 같은 outbox를 가져가지 못하게 하는 lease 유효 시간(ms)입니다.
LIFECYCLE_OUTBOX_LEASE_DURATION_MS=30000
# terminal dead-letter 상태로 전환하기 전 outbox 전달 총 최대 시도 횟수입니다.
LIFECYCLE_OUTBOX_MAX_ATTEMPTS=10
# published/dead-letter outbox를 정리하는 scheduler 주기(ms)입니다.
LIFECYCLE_OUTBOX_CLEANUP_INTERVAL_MS=86400000
# cleanup query 한 batch에서 삭제할 최대 row 수입니다.
LIFECYCLE_OUTBOX_CLEANUP_BATCH_SIZE=250
# cleanup 한 번 실행에서 처리할 최대 batch 수입니다.
LIFECYCLE_OUTBOX_CLEANUP_MAX_BATCHES_PER_RUN=20
# cleanup batch 사이 sleep(ms)입니다. DB 부하를 완화합니다.
LIFECYCLE_OUTBOX_CLEANUP_BATCH_SLEEP_MS=100
# cleanup query가 DB lock을 기다리는 최대 시간(ms)입니다.
LIFECYCLE_OUTBOX_CLEANUP_LOCK_TIMEOUT_MS=1000
# 성공적으로 published된 outbox의 보존 일수입니다.
LIFECYCLE_OUTBOX_PUBLISHED_RETENTION_DAYS=30
# terminal dead-letter outbox의 보존 일수입니다. 장애 분석 기간보다 짧게 잡지 마세요.
LIFECYCLE_OUTBOX_DEAD_LETTER_RETENTION_DAYS=90

# ── Authoritative metadata와 비동기 variant ─────────────────────────────────
# true이면 upload/delete를 ImageAsset/ImageVariant authoritative metadata에 기록합니다.
# migration의 expand/backfill 완료 후 켜세요.
IMAGE_ASSET_METADATA_WRITES_ENABLED=true
# true이면 metadata에 없는 legacy imageKey를 filesystem에서 보조 조회합니다.
# authoritative 전환이 끝난 뒤 false로 내려 legacy fallback을 종료합니다.
IMAGE_ASSET_DUAL_READ_ENABLED=true
# true이면 Idempotency-Key, externalImageId 또는 signed context requestId 없는 upload를 거부합니다.
IMAGE_UPLOAD_IDEMPOTENCY_STRICT=false
# source asset Ready 이후 variant job을 Kafka로 처리하는 worker를 활성화합니다.
IMAGE_VARIANT_KAFKA_ENABLED=true
# storage가 발행하고 variant worker가 소비할 job topic입니다.
IMAGE_VARIANT_KAFKA_TOPIC=file.image.variant.jobs.v1
# 정해진 재시도 이후 처리하지 못한 variant job의 DLQ topic입니다.
IMAGE_VARIANT_KAFKA_DLQ_TOPIC=file.image.variant.jobs.v1.dlq
# variant worker consumer group입니다. 같은 환경의 replica끼리는 같은 group을 사용합니다.
IMAGE_VARIANT_KAFKA_GROUP_ID=file-image-variant-worker-v1
# Kafka event handler가 DLQ 전까지 시도할 총 최대 횟수입니다.
IMAGE_VARIANT_KAFKA_RETRY_MAX_ATTEMPTS=3
# Kafka event handler 재시도 사이 기준 backoff(ms)입니다.
IMAGE_VARIANT_KAFKA_RETRY_BACKOFF_MS=100
# ImageVariant job 자체를 Failed로 확정하기 전 총 최대 처리 횟수입니다.
IMAGE_VARIANT_JOB_MAX_ATTEMPTS=3
# 실패한 variant job을 다시 실행하기 전 기준 backoff(ms)입니다.
IMAGE_VARIANT_JOB_RETRY_BACKOFF_MS=1000
# 모든 cache replica에 image/version 무효화를 전달할 topic입니다.
# cache 앱의 CACHE_INVALIDATION_KAFKA_TOPIC과 같아야 합니다.
CACHE_INVALIDATION_KAFKA_TOPIC=file.image.cache-invalidation.v1
# cache invalidation outbox 전달의 총 최대 시도 횟수입니다.
CACHE_INVALIDATION_KAFKA_RETRY_MAX_ATTEMPTS=3
# cache invalidation 전달 재시도 사이 기준 backoff(ms)입니다.
CACHE_INVALIDATION_KAFKA_RETRY_BACKOFF_MS=100
# variant job outbox를 Kafka로 발행하는 worker 주기(ms)입니다.
IMAGE_VARIANT_OUTBOX_PUBLISH_INTERVAL_MS=1000
# 한 번에 발행할 variant job outbox 최대 개수입니다.
IMAGE_VARIANT_OUTBOX_PUBLISH_BATCH_SIZE=25
# true이면 upload 요청 안에서 legacy 동기 PRE_GENERATE도 실행합니다.
# 비동기 worker가 안정화되는 짧은 전환 기간에만 사용하세요.
IMAGE_PREGENERATION_SYNC_COMPAT_ENABLED=false
# Pending/Deleting asset이 이 시간(ms)보다 오래 지속되면 readiness를 실패시키는 기준입니다.
IMAGE_LIFECYCLE_READINESS_MAX_ACTIVE_STATE_AGE_MS=300000
# 가장 오래 지연된 variant job age가 이 값(ms)을 넘으면 readiness를 실패시킵니다.
IMAGE_VARIANT_READINESS_MAX_LAG_MS=300000
# Failed ImageAsset 수가 이 값을 초과하면 readiness를 실패시킵니다. 0은 실패 1건도 허용하지 않습니다.
IMAGE_ASSET_FAILED_READINESS_THRESHOLD=0
# Failed ImageVariant 수가 이 값을 초과하면 readiness를 실패시킵니다.
IMAGE_VARIANT_FAILED_READINESS_THRESHOLD=0
# terminal Failed variant job 수가 이 값을 초과하면 readiness를 실패시킵니다.
IMAGE_VARIANT_JOB_FAILED_READINESS_THRESHOLD=0

# ── Filesystem/metadata reconciliation ───────────────────────────────────────
# true이면 stale metadata, temp file, orphan file, 미완료 삭제를 점검/복구합니다.
IMAGE_RECONCILIATION_ENABLED=true
# reconciliation scheduler가 실행을 시도하는 주기(ms)입니다.
IMAGE_RECONCILIATION_INTERVAL_MS=60000
# reconciliation 내부 batch 사이 sleep(ms)입니다. 미설정 시 interval 값을 사용합니다.
IMAGE_RECONCILIATION_BATCH_SLEEP_MS=60000
# Pending/temp/Deleting 상태를 stale로 판단하기 전 최소 age(ms)입니다.
IMAGE_RECONCILIATION_STALE_AFTER_MS=240000
# 한 replica가 reconciliation 실행권을 보유하는 DB lease 시간(ms)입니다.
IMAGE_RECONCILIATION_LEASE_MS=55000
# reconciliation query가 advisory/row lock을 기다리는 최대 시간(ms)입니다.
IMAGE_RECONCILIATION_LOCK_TIMEOUT_MS=2000
# metadata 상태 복구 query 한 batch에서 처리할 최대 asset 수입니다.
IMAGE_RECONCILIATION_BATCH_SIZE=100
# 한 실행에서 filesystem object를 검사할 최대 개수입니다.
IMAGE_RECONCILIATION_OBJECT_SCAN_LIMIT=1000
# 한 실행에서 오래된 staged temp file을 정리할 최대 개수입니다.
IMAGE_RECONCILIATION_STAGE_CLEANUP_LIMIT=1000
# 한 실행에서 오래된 inbound upload temp file을 정리할 최대 개수입니다.
IMAGE_RECONCILIATION_INBOUND_TEMP_CLEANUP_LIMIT=1000
# true이면 metadata가 없는 filesystem file을 삭제합니다.
# expand/backfill/dual-read 중에는 반드시 false, authoritative switch 검증 후에만 true로 바꾸세요.
IMAGE_RECONCILIATION_ORPHAN_DELETE_ENABLED=false
# 마지막 성공 reconciliation이 이 시간(ms)보다 오래되면 readiness를 실패시킵니다.
IMAGE_RECONCILIATION_READINESS_MAX_STALENESS_MS=300000
# true이면 구형 health consumer용 supported=false/orphanCount=null 응답을 유지합니다.
# 전환 기간에만 사용하고 모든 consumer 갱신 후 false로 종료하세요.
IMAGE_RECONCILIATION_HEALTH_LEGACY_COMPAT_ENABLED=false

# ── System E2E 전용 장애 주입 ────────────────────────────────────────────────
# production에서 failpoint 이름이 설정되었는데 명시적으로 허용하지 않으면 앱은 fail-closed합니다.
# true일 때만 아래 장애 주입을 허용합니다. 운영에서는 절대 켜지 마세요.
# IMAGE_LIFECYCLE_TEST_FAILPOINTS_ENABLED=true
# 중단시킬 staged upload/delete 처리 지점 이름입니다(예: after-pending).
# IMAGE_LIFECYCLE_TEST_FAILPOINT=after-pending
# failpoint 도달 시 동작입니다. system harness의 프로세스 중단 검증에는 exit을 사용합니다.
# IMAGE_LIFECYCLE_TEST_FAILPOINT_ACTION=exit
