{
	"name": "@file/storage",
	"version": "0.0.1",
	"private": true,
	"description": "",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/apps/storage/src/main",
		"lint": "yarn exec eslint \"src/**/*.ts\" \"test/**/*.ts\"",
		"test": "yarn exec jest --passWithNoTests",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "yarn exec jest --config ./test/jest-e2e.json --passWithNoTests",
		"lint:fix": "yarn exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix"
	},
	"dependencies": {
		"@file/global": "*",
		"@nestjs/common": "^11.1.27",
		"@nestjs/core": "^11.1.27",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/microservices": "^11.1.27",
		"@nestjs/platform-express": "^11.1.27",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"kafkajs": "^2.2.4",
		"mime-types": "^2.1.35",
		"nest-typed-config": "^2.10.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sharp": "^0.33.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.23",
		"config": "*"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
