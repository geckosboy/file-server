{
	"moduleFileExtensions": [
		"js",
		"json",
		"ts"
	],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"moduleNameMapper": {
		"^src/(.*)$": "<rootDir>/../src/$1",
		"^@file/global$": "<rootDir>/../../../libs/global/src",
		"^@file/global/(.*)$": "<rootDir>/../../../libs/global/src/$1",
		"^@file/nest-common$": "<rootDir>/../../../libs/nest-common/src",
		"^@file/nest-common/(.*)$": "<rootDir>/../../../libs/nest-common/src/$1",
		"^@file/image-contracts$": "<rootDir>/../../../libs/image-contracts/src",
		"^@file/image-contracts/(.*)$": "<rootDir>/../../../libs/image-contracts/src/$1"
	}
}
