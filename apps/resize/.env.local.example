# apps/resize/.env.local로 복사해서 사용합니다.
# resize는 원본을 storage에서 읽고 Sharp로 변환하며, 원본 파일의 authoritative 저장소가 아닙니다.

# 실행 환경입니다.
NODE_ENV=development
# HTTP 서버 bind 주소입니다. 컨테이너에서는 0.0.0.0을 사용하세요.
HOST=127.0.0.1
# resize 앱의 HTTP 포트입니다.
PORT=3031
# CORS 허용 origin의 쉼표 구분 목록입니다.
ORIGIN_LIST_STR=http://localhost:3000,http://127.0.0.1:3000

# Kafka broker의 쉼표 구분 목록입니다. health/telemetry 연결에도 사용합니다.
KAFKA_CLIENT_BROKERS=localhost:9094
# TLS 사용 여부입니다. true이면 CA 파일이 필요합니다.
# KAFKA_SSL_ENABLED=true
# Kafka broker 인증서를 검증할 PEM CA 파일 경로입니다.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
# SASL 방식입니다: plain, scram-sha-256, scram-sha-512 중 하나입니다.
# KAFKA_SASL_MECHANISM=plain
# resize 전용 Kafka principal입니다.
# KAFKA_SASL_USERNAME=file_server_resize
# resize principal 비밀번호입니다. 실제 값을 커밋하지 마세요.
# KAFKA_SASL_PASSWORD=replace-with-secret

# Client Service/API key와 이미지 metadata를 조회할 PostgreSQL URL입니다.
# storage, cache, telemetry-api와 같은 DB를 가리켜야 합니다.
DATABASE_URL=postgresql://file_server:file_server@127.0.0.1:5432/file_server
# API key hash 검증용 pepper입니다. 발급 시 사용한 값 및 다른 서버 앱과 같아야 합니다.
CLIENT_API_KEY_PEPPER=dev-local-pepper
# storage/resize/cache 사이 내부 호출용 공유 key입니다. 외부에 노출하지 마세요.
INTERNAL_API_KEY=dev-internal-key
# readiness probe 한 번을 기다리는 최대 시간(ms)입니다.
HEALTH_PROBE_TIMEOUT_MS=2000
# readiness probe 결과를 재사용하는 시간(ms)입니다.
HEALTH_PROBE_CACHE_TTL_MS=1000
# storage GET 호출의 1회 deadline(ms)입니다. timeout은 504로 보존됩니다.
UPSTREAM_HTTP_TIMEOUT_MS=2000
# 원본 이미지를 읽을 storage 앱 base URL입니다.
STORAGE_SERVER=http://127.0.0.1:3032
# 멱등 GET에 한해 storage 호출을 추가로 시도할 최대 횟수입니다.
UPSTREAM_HTTP_MAX_RETRIES=1
# GET 재시도 사이 bounded backoff 기준 시간(ms)입니다.
UPSTREAM_HTTP_RETRY_BACKOFF_MS=100
# storage 응답으로 읽을 최대 byte 수입니다. 초과 응답은 변환 전에 거부합니다.
UPSTREAM_IMAGE_MAX_RESPONSE_BYTES=20971520
# 디코딩할 입력 이미지의 최대 총 pixel 수입니다. decompression bomb 방어 한도입니다.
IMAGE_MAX_INPUT_PIXELS=40000000
# Sharp 변환 결과로 허용할 최대 byte 수입니다.
IMAGE_MAX_OUTPUT_BYTES=20971520
# 프로세스당 Sharp 작업 동시성 상한입니다. CPU/RSS 용량에 맞춰 조정하세요.
SHARP_CONCURRENCY=2
