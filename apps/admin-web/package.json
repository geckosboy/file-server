{
	"name": "@file/admin-web",
	"version": "0.0.1",
	"private": true,
	"description": "파일 서버 관리자 대시보드 MVP",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"start": "next start",
		"typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
		"lint": "pnpm exec eslint \"src/**/*.{ts,tsx}\"",
		"lint:fix": "pnpm exec eslint \"src/**/*.{ts,tsx}\" --fix",
		"test": "pnpm exec jest --passWithNoTests"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"next": "^16.2.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@file/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.16",
		"tailwindcss": "^4.3.2"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts",
			"tsx"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.tsx?$",
		"transform": {
			"^.+\\.(t|j)sx?$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1"
		}
	}
}
