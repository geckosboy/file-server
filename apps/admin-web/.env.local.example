# apps/admin-web/.env.local로 복사해서 사용합니다.
# 예제 secret은 로컬 개발용입니다. 운영에서는 secret manager로 주입하세요.

# Next.js admin-web가 수신할 HTTP 포트입니다.
PORT=3000
# telemetry-api의 관리자 API base URL입니다. 끝 경로는 /api/admin이어야 합니다.
TELEMETRY_API_BASE_URL=http://localhost:3100/api/admin
# admin-web가 telemetry-api health를 확인할 때 기다리는 최대 시간(ms)입니다.
ADMIN_WEB_HEALTH_TIMEOUT_MS=2000
# telemetry-api의 TELEMETRY_ADMIN_TOKEN과 반드시 같은 관리자 Bearer token입니다.
# 브라우저에 노출되는 NEXT_PUBLIC_* 변수로 만들면 안 됩니다.
TELEMETRY_ADMIN_TOKEN=dev-admin-token
# 인증된 reverse proxy가 x-file-admin-proxy-secret 헤더에 넣을 공유 secret입니다.
# 운영에서는 충분히 긴 임의값을 사용하고 외부 클라이언트에 공개하지 마세요.
ADMIN_WEB_PROXY_SECRET=replace-with-reverse-proxy-secret
# true이면 비운영 환경에서 reverse proxy 관리자 인증을 생략합니다.
# production에서는 이 값이 true여도 무시되므로 로컬 개발에서만 사용하세요.
ADMIN_WEB_AUTH_DISABLED=true
# true이면 비운영 환경에서 telemetry-api 장애 시 fixture 응답을 허용합니다.
# 운영에서는 실제 장애를 숨기지 않도록 사용하지 마세요.
ADMIN_WEB_ENABLE_FIXTURES=true
