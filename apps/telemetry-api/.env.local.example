# apps/telemetry-api/.env.local로 복사해서 사용합니다.
# 운영 telemetry/lifecycle 조회, 관리자 API, retention 및 Client Service topic provisioning을 담당합니다.

# 실행 환경입니다. production에서는 필수 secret이 없으면 부팅을 거부합니다.
NODE_ENV=development
# HTTP 서버 bind 주소입니다. 컨테이너에서는 0.0.0.0을 사용하세요.
HOST=127.0.0.1
# telemetry-api HTTP 포트입니다.
PORT=3100
# telemetry/lifecycle/audit 및 authoritative image metadata를 조회할 PostgreSQL URL입니다.
# root Prisma CLI 및 storage, resize, cache와 같은 DB를 가리켜야 합니다.
DATABASE_URL=postgresql://file_server:file_server@127.0.0.1:5432/file_server
# signed internal context를 검증하는 공유 key입니다. storage/resize/cache와 같은 값을 사용하세요.
INTERNAL_API_KEY=dev-internal-key
# Client Service/API key hash 검증용 pepper입니다. 발급 시 사용한 값 및 다른 서버 앱과 같아야 합니다.
CLIENT_API_KEY_PEPPER=dev-local-pepper
# 관리자 API Bearer token입니다. admin-web의 TELEMETRY_ADMIN_TOKEN과 같아야 합니다.
TELEMETRY_ADMIN_TOKEN=dev-admin-token
# telemetry-api가 허용할 관리자 UI origin의 쉼표 구분 목록입니다. wildcard(*)는 거부됩니다.
TELEMETRY_CORS_ORIGINS=http://localhost:3000
# readiness의 DB/Kafka 상태 확인을 기다리는 최대 시간(ms)입니다.
HEALTH_PROBE_TIMEOUT_MS=2000
# true이면 Kafka 외에 HTTP telemetry ingestion endpoint도 활성화합니다.
TELEMETRY_HTTP_INGESTION_ENABLED=true
# HTTP ingestion Bearer token입니다. 관리자 token과 다른 값을 사용하세요.
TELEMETRY_INGESTION_TOKEN=dev-ingestion-token

# ── 공통 Kafka 연결 보안 ─────────────────────────────────────────────────────
# 공통 Kafka broker의 쉼표 구분 목록입니다. consumer별 broker가 없을 때 fallback입니다.
KAFKA_CLIENT_BROKERS=localhost:9094
# TLS 사용 여부입니다. true이면 읽을 수 있는 CA 파일 경로가 필요합니다.
# KAFKA_SSL_ENABLED=true
# Kafka broker 인증서를 검증할 PEM CA 파일 경로입니다.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
# SASL 방식입니다: plain, scram-sha-256, scram-sha-512 중 하나입니다.
# KAFKA_SASL_MECHANISM=plain
# telemetry-api consumer/admin 권한을 가진 Kafka principal입니다.
# KAFKA_SASL_USERNAME=file_server_telemetry
# Kafka principal 비밀번호입니다. 실제 값을 저장소에 커밋하지 마세요.
# KAFKA_SASL_PASSWORD=replace-with-secret

# ── Telemetry Kafka consumer ─────────────────────────────────────────────────
# telemetry consumer 실행 여부입니다. false이면 Kafka를 소비하지 않습니다.
TELEMETRY_KAFKA_CONSUMER_ENABLED=true
# telemetry consumer 전용 broker 목록입니다. 미설정 시 KAFKA_CLIENT_BROKERS를 사용합니다.
# TELEMETRY_KAFKA_BROKERS=localhost:9094
# broker 로그/metric에 표시할 Kafka client.id입니다.
TELEMETRY_KAFKA_CLIENT_ID=telemetry-api
# 동일 환경의 telemetry-api replica가 공유할 consumer group입니다.
TELEMETRY_KAFKA_GROUP_ID=file-telemetry-api
# 공용 telemetry event topic입니다. producer 설정과 같아야 합니다.
TELEMETRY_KAFKA_TOPIC=file.image.events.v1
# poison event를 terminal failure로 보낼 DLQ topic입니다.
TELEMETRY_KAFKA_DLQ_TOPIC=file.image.events.v1.dlq
# group offset이 없을 때 topic 처음부터 읽을지 결정합니다.
TELEMETRY_KAFKA_FROM_BEGINNING=false
# manual commit 전 event 처리의 총 최대 시도 횟수입니다.
TELEMETRY_KAFKA_RETRY_MAX_ATTEMPTS=3
# event 처리 재시도 사이 기준 backoff(ms)입니다.
TELEMETRY_KAFKA_RETRY_BACKOFF_MS=100
# 최초/재연결 실패 후 시작 backoff(ms)입니다.
TELEMETRY_KAFKA_CONNECT_RETRY_BACKOFF_MS=500
# reconnect exponential backoff의 최대값(ms)입니다.
TELEMETRY_KAFKA_CONNECT_RETRY_MAX_BACKOFF_MS=10000
# broker offset과 consumer group offset으로 실제 lag를 다시 계산하는 주기(ms)입니다.
TELEMETRY_KAFKA_LAG_REFRESH_INTERVAL_MS=5000

# ── Lifecycle Kafka consumer ─────────────────────────────────────────────────
# lifecycle consumer 실행 여부입니다. false이면 lifecycle admin 조회가 새 event를 받지 않습니다.
LIFECYCLE_KAFKA_CONSUMER_ENABLED=true
# lifecycle consumer 전용 broker 목록입니다. 미설정 시 KAFKA_CLIENT_BROKERS를 사용합니다.
# LIFECYCLE_KAFKA_BROKERS=localhost:9094
# broker 로그/metric에 표시할 lifecycle Kafka client.id입니다.
LIFECYCLE_KAFKA_CLIENT_ID=telemetry-api-lifecycle
# 동일 환경의 telemetry-api replica가 공유할 lifecycle consumer group입니다.
LIFECYCLE_KAFKA_GROUP_ID=file-telemetry-api-lifecycle
# file-server 내부 공용 lifecycle topic입니다. Client Service 전용 topic과 구분하세요.
LIFECYCLE_KAFKA_TOPIC=file.image.lifecycle.v1
# 처리하지 못한 공용 lifecycle event의 DLQ topic입니다.
LIFECYCLE_KAFKA_DLQ_TOPIC=file.image.lifecycle.v1.dlq
# group offset이 없을 때 lifecycle topic 처음부터 읽을지 결정합니다.
LIFECYCLE_KAFKA_FROM_BEGINNING=false
# manual commit 전 lifecycle event 처리의 총 최대 시도 횟수입니다.
LIFECYCLE_KAFKA_RETRY_MAX_ATTEMPTS=3
# lifecycle event 처리 재시도 사이 기준 backoff(ms)입니다.
LIFECYCLE_KAFKA_RETRY_BACKOFF_MS=100
# lifecycle consumer 최초/재연결 실패 후 시작 backoff(ms)입니다.
LIFECYCLE_KAFKA_CONNECT_RETRY_BACKOFF_MS=500
# lifecycle consumer reconnect backoff의 최대값(ms)입니다.
LIFECYCLE_KAFKA_CONNECT_RETRY_MAX_BACKOFF_MS=10000
# lifecycle broker/group offset lag를 다시 계산하는 주기(ms)입니다.
LIFECYCLE_KAFKA_LAG_REFRESH_INTERVAL_MS=5000

# ── Database retention ───────────────────────────────────────────────────────
# true이면 오래된 telemetry/lifecycle/audit row를 bounded batch로 정리합니다.
DATA_RETENTION_ENABLED=false
# retention scheduler 실행 주기(ms)입니다. 0은 scheduler를 비활성화합니다.
DATA_RETENTION_INTERVAL_MS=86400000
# telemetry event 보존 일수입니다. 최소 1일이며 기본 운영 정책은 90일입니다.
TELEMETRY_RETENTION_DAYS=90
# lifecycle event 보존 일수입니다. 0이면 삭제하지 않습니다. 운영 책임자 승인 후 설정하세요.
LIFECYCLE_EVENT_RETENTION_DAYS=0
# 관리자 audit 보존 일수입니다. 0이면 삭제하지 않습니다. 법적/보안 정책을 먼저 확인하세요.
ADMIN_AUDIT_RETENTION_DAYS=0
# 한 retention batch에서 삭제할 최대 row 수입니다.
DATA_RETENTION_BATCH_SIZE=250
# scheduler 한 번 실행에서 처리할 최대 batch 수입니다.
DATA_RETENTION_MAX_BATCHES_PER_RUN=20
# batch 사이 sleep(ms)입니다. DB 부하와 replication lag를 완화합니다.
DATA_RETENTION_BATCH_SLEEP_MS=100
# 삭제 query가 lock을 기다리는 최대 시간(ms)입니다. 초과 시 다음 실행에서 재시도합니다.
DATA_RETENTION_LOCK_TIMEOUT_MS=1000

# ── Client Service lifecycle topic provisioning ─────────────────────────────
# true이면 subscription 생성 시 Client Service 전용 topic/ACL을 자동 provisioning합니다.
LIFECYCLE_TOPIC_PROVISIONING_ENABLED=false
# provisioning admin이 접속할 broker 목록입니다. 미설정 시 KAFKA_CLIENT_BROKERS를 사용합니다.
# LIFECYCLE_TOPIC_ADMIN_BROKERS=kafka-1:9094,kafka-2:9094,kafka-3:9094
# broker 로그/metric에서 provisioning 작업을 식별할 Kafka admin client.id입니다.
LIFECYCLE_TOPIC_ADMIN_CLIENT_ID=file-lifecycle-topic-provisioner
# Kafka admin API가 topic/ACL provisioning을 재시도할 최대 횟수입니다.
LIFECYCLE_TOPIC_ADMIN_RETRIES=5
# 새 Client Service 전용 lifecycle topic의 partition 수입니다.
LIFECYCLE_CLIENT_TOPIC_PARTITIONS=6
# 새 전용 topic의 replication factor입니다. broker 수 이하로 설정하세요.
LIFECYCLE_CLIENT_TOPIC_REPLICATION_FACTOR=3
# 새 전용 topic의 min.insync.replicas입니다. replication factor 이하로 설정하세요.
LIFECYCLE_CLIENT_TOPIC_MIN_ISR=2

# ── Authoritative metadata/health 전환 설정 ─────────────────────────────────
# admin 목록에서 metadata가 없는 legacy imageKey를 보조 조회할지 결정합니다.
# storage의 IMAGE_ASSET_DUAL_READ_ENABLED와 같은 전환 단계 값을 사용하세요.
IMAGE_ASSET_DUAL_READ_ENABLED=true
# true이면 reconciliation health를 구형 supported=false/orphanCount=null 형태로 반환합니다.
# consumer 전환 기간에만 켜고 storage의 같은 설정과 함께 종료하세요.
IMAGE_RECONCILIATION_HEALTH_LEGACY_COMPAT_ENABLED=false

# 아래 driver는 테스트/격리 개발용입니다. 운영에서는 주석 상태(Prisma)를 유지하세요.
# TELEMETRY_STORAGE_DRIVER=memory
# LIFECYCLE_STORAGE_DRIVER=memory
# CLIENT_SERVICE_REGISTRY_DRIVER=memory
