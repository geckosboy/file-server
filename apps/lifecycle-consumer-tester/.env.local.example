# apps/lifecycle-consumer-tester/.env.local로 복사해서 사용합니다.
# 외부 Client Service가 받는 lifecycle event 계약과 Kafka 격리를 확인하는 테스트 UI/API입니다.

# 실행 환경입니다.
NODE_ENV=development
# HTTP 서버 bind 주소입니다. 컨테이너에서는 0.0.0.0을 사용하세요.
HOST=127.0.0.1
# lifecycle-consumer-tester HTTP 포트입니다.
PORT=3110

# Kafka broker의 쉼표 구분 목록입니다.
KAFKA_CLIENT_BROKERS=localhost:9094
# Kafka consumer 실행 여부입니다. false이면 HTTP UI/API만 실행하고 event를 소비하지 않습니다.
LIFECYCLE_CONSUMER_TESTER_ENABLED=true
# TLS 사용 여부입니다. true이면 CA 파일을 함께 설정해야 합니다.
# KAFKA_SSL_ENABLED=true
# Kafka broker 인증서를 검증할 PEM CA 파일 경로입니다.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
# SASL 방식입니다: plain, scram-sha-256, scram-sha-512 중 하나입니다.
# KAFKA_SASL_MECHANISM=plain
# 테스트 대상 Client Service 전용 consumer principal입니다.
# KAFKA_SASL_USERNAME=client_service_consumer
# consumer principal 비밀번호입니다. 실제 값은 secret manager로 주입하세요.
# KAFKA_SASL_PASSWORD=replace-with-secret
# Kafka client.id입니다. broker 로그와 metric에서 이 consumer를 식별합니다.
LIFECYCLE_KAFKA_CLIENT_ID=lifecycle-consumer-tester
# consumer group입니다. 실제 통합 테스트에서는 Client Service 전용 group을 사용하세요.
LIFECYCLE_KAFKA_GROUP_ID=lifecycle-consumer-tester-local
# 구독할 lifecycle topic입니다. 운영 통합에서는 provisioning된 Client Service 전용 topic을 사용하세요.
LIFECYCLE_KAFKA_TOPIC=file.image.lifecycle.v1
# true이면 group에 저장된 offset이 없을 때 topic 처음부터 읽습니다.
LIFECYCLE_KAFKA_FROM_BEGINNING=true
# UI/API가 메모리에 보관할 최근 event 최대 개수입니다.
LIFECYCLE_CONSUMER_TESTER_MAX_EVENTS=200

# 선택 필터: 지정하면 이 Client Service UUID의 event만 보관합니다. 빈 값은 전체 허용입니다.
CLIENT_SERVICE_ID=
# 선택 필터: 지정하면 이 Client Service slug의 event만 보관합니다. 빈 값은 전체 허용입니다.
CLIENT_SERVICE_SLUG=
# 저장할 eventType의 쉼표 구분 allowlist입니다.
KAFKA_LIFECYCLE_EVENT_TYPES=image.upload.completed,image.upload.failed
