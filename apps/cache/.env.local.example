# apps/cache/.env.local로 복사해서 사용합니다.
# cache는 변환 이미지를 메모리에 보관하고 resize upstream 호출을 singleflight로 합칩니다.

# 실행 환경입니다. production에서는 보안 검증과 오류 노출 정책이 강화됩니다.
NODE_ENV=development
# HTTP 서버 bind 주소입니다. 컨테이너에서는 0.0.0.0을 사용하세요.
HOST=127.0.0.1
# cache 앱의 HTTP 포트입니다.
PORT=3030
# CORS 허용 origin의 쉼표 구분 목록입니다. * 대신 실제 origin을 지정하세요.
ORIGIN_LIST_STR=http://localhost:3000,http://127.0.0.1:3000

# Kafka broker의 쉼표 구분 목록입니다. 호스트 실행은 localhost, Compose 내부는 서비스명을 사용합니다.
KAFKA_CLIENT_BROKERS=localhost:9094
# TLS 사용 여부입니다. true이면 읽을 수 있는 CA 파일 경로가 필요합니다.
# KAFKA_SSL_ENABLED=true
# Kafka broker 인증서를 검증할 PEM CA 파일 경로입니다.
# KAFKA_SSL_CA_FILE=/run/secrets/kafka-ca.crt
# SASL 방식입니다: plain, scram-sha-256, scram-sha-512 중 하나를 사용합니다.
# KAFKA_SASL_MECHANISM=plain
# cache 전용 Kafka principal입니다. 다른 앱 principal을 공유하지 않는 것이 원칙입니다.
# KAFKA_SASL_USERNAME=file_server_cache
# 위 principal의 비밀번호입니다. 저장소에 실제 값을 커밋하지 마세요.
# KAFKA_SASL_PASSWORD=replace-with-secret

# Client Service/API key 검증에 사용할 PostgreSQL URL입니다.
# storage, resize, telemetry-api와 같은 DB를 가리켜야 합니다.
DATABASE_URL=postgresql://file_server:file_server@127.0.0.1:5432/file_server
# API key hash 검증용 pepper입니다. 발급 시 사용한 값 및 모든 서버 앱과 같아야 합니다.
# 변경하면 기존 API key를 검증할 수 없으므로 secret rotation 절차 없이 바꾸면 안 됩니다.
CLIENT_API_KEY_PEPPER=dev-local-pepper
# cache miss 시 호출할 resize 앱 base URL입니다.
RESIZING_SERVER=http://127.0.0.1:3031
# resize GET 호출의 1회 deadline(ms)입니다. timeout은 클라이언트에 504로 전달됩니다.
UPSTREAM_HTTP_TIMEOUT_MS=2000
# 멱등 GET에 한해 timeout/일시 오류 후 추가로 시도할 최대 횟수입니다.
UPSTREAM_HTTP_MAX_RETRIES=1
# GET 재시도 사이 bounded backoff의 기준 시간(ms)입니다.
UPSTREAM_HTTP_RETRY_BACKOFF_MS=100
# resize upstream 응답으로 허용할 최대 byte 수입니다. 초과 응답은 거부합니다.
UPSTREAM_IMAGE_MAX_RESPONSE_BYTES=20971520
# storage/resize/cache 사이 내부 호출을 인증하는 공유 key입니다.
# 세 앱에서 같은 값을 사용하고 외부 요청에는 절대 노출하지 마세요.
INTERNAL_API_KEY=dev-internal-key
# readiness에서 DB/Kafka/upstream probe 한 번을 기다리는 최대 시간(ms)입니다.
HEALTH_PROBE_TIMEOUT_MS=2000
# readiness probe 결과를 재사용하는 시간(ms)입니다. 과도한 probe 부하를 제한합니다.
HEALTH_PROBE_CACHE_TTL_MS=1000
# 같은 tenant/image/variant 요청을 합친 singleflight가 기다릴 최대 시간(ms)입니다.
CACHE_SINGLEFLIGHT_TIMEOUT_MS=5000
# 프로세스 한 개가 이미지 cache에 사용할 총 byte 상한입니다. 초과하면 LRU eviction합니다.
CACHE_MAX_BYTES=268435456

# 모든 cache replica에 삭제/변경을 전달하는 Kafka invalidation consumer를 켭니다.
CACHE_INVALIDATION_KAFKA_ENABLED=true
# storage가 발행하는 cache invalidation topic입니다. storage 설정과 같아야 합니다.
CACHE_INVALIDATION_KAFKA_TOPIC=file.image.cache-invalidation.v1
# 재시도 후에도 처리하지 못한 invalidation event를 보낼 DLQ topic입니다.
CACHE_INVALIDATION_KAFKA_DLQ_TOPIC=file.image.cache-invalidation.v1.dlq
# replica마다 고유해야 하는 consumer group입니다. 미설정 시 hostname+pid 기반으로 생성됩니다.
# 같은 group을 공유하면 일부 replica만 event를 받아 cache가 오래 남을 수 있습니다.
# CACHE_INVALIDATION_KAFKA_GROUP_ID=file-cache-invalidation-v1-<replica-id>
# invalidation event 처리의 총 최대 시도 횟수입니다.
CACHE_INVALIDATION_KAFKA_RETRY_MAX_ATTEMPTS=3
# invalidation 처리 재시도 사이의 기준 backoff(ms)입니다.
CACHE_INVALIDATION_KAFKA_RETRY_BACKOFF_MS=100
