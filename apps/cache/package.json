{
	"name": "@file/cache",
	"version": "0.0.1",
	"private": true,
	"description": "",
	"author": "",
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/apps/cache/src/main",
		"lint": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint:fix": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
		"test": "pnpm exec jest --passWithNoTests",
		"test:e2e": "pnpm exec jest --config ./test/jest-e2e.json --passWithNoTests"
	},
	"dependencies": {
		"@file/global": "workspace:*",
		"@nestjs/common": "^11.1.27",
		"@nestjs/core": "^11.1.27",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/platform-express": "^11.1.27",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"mime-types": "^2.1.35",
		"nest-typed-config": "^2.10.1",
		"node-cache": "^5.1.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.23",
		"config": "workspace:*"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1",
			"^@file/global$": "<rootDir>/../../../libs/global/src",
			"^@file/global/(.*)$": "<rootDir>/../../../libs/global/src/$1"
		}
	}
}
