generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ClientService {
  id          String  @id(map: "client_services_pkey") @default(cuid())
  slug        String  @unique(map: "client_services_slug_key")
  name        String
  description String?
  owner       String?
  status      String  @default("ACTIVE")

  keys                   ClientServiceKey[]
  policies               ClientServicePolicy[]
  rateLimitWindows       ClientServiceRateLimitWindow[]
  adminAuditLogs         AdminAuditLog[]
  lifecycleSubscriptions ClientServiceLifecycleSubscription[]
  imageResizePolicy      ClientServiceImageResizePolicy?
  imageAssets            ImageAsset[]
  events                 TelemetryEvent[]
  lifecycleEvents        ImageLifecycleEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status], map: "client_services_status_idx")
  @@map("client_services")
}

model ClientServiceKey {
  id              String        @id(map: "client_service_keys_pkey") @default(cuid())
  clientServiceId String        @map("client_service_id")
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade, map: "client_service_keys_client_service_id_fkey")

  name       String?
  keyPrefix  String    @unique(map: "client_service_keys_key_prefix_key") @map("key_prefix")
  keyHash    String    @unique(map: "client_service_keys_key_hash_key") @map("key_hash")
  scopes     Json?
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")

  rateLimitWindows ClientServiceRateLimitWindow[]

  @@index([clientServiceId], map: "client_service_keys_client_service_id_idx")
  @@index([revokedAt], map: "client_service_keys_revoked_at_idx")
  @@index([expiresAt], map: "client_service_keys_expires_at_idx")
  @@map("client_service_keys")
}

model ClientServicePolicy {
  id              String        @id(map: "client_service_policies_pkey") @default(cuid())
  clientServiceId String        @map("client_service_id")
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade, map: "client_service_policies_client_service_id_fkey")

  pathPattern     String  @map("path_pattern")
  canRead         Boolean @default(true) @map("can_read")
  canUpload       Boolean @default(false) @map("can_upload")
  canDelete       Boolean @default(false) @map("can_delete")
  maxUploadBytes  Int?    @map("max_upload_bytes")
  rateLimitPerMin Int?    @map("rate_limit_per_min")
  metadata        Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientServiceId], map: "client_service_policies_client_service_id_idx")
  @@index([pathPattern], map: "client_service_policies_path_pattern_idx")
  @@map("client_service_policies")
}

model ClientServiceRateLimitWindow {
  clientServiceId    String           @map("client_service_id")
  clientService      ClientService    @relation(fields: [clientServiceId], references: [id], onDelete: Cascade, map: "client_service_rate_limit_windows_client_service_id_fkey")
  clientServiceKeyId String           @map("client_service_key_id")
  clientServiceKey   ClientServiceKey @relation(fields: [clientServiceKeyId], references: [id], onDelete: Cascade, map: "client_service_rate_limit_windows_client_service_key_id_fkey")

  action          String
  windowStartedAt DateTime @map("window_started_at")
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([clientServiceKeyId, action, windowStartedAt], map: "client_service_rate_limit_windows_pkey")
  @@index([clientServiceId, windowStartedAt], map: "client_service_rate_limit_windows_service_window_idx")
  @@index([windowStartedAt], map: "client_service_rate_limit_windows_window_started_at_idx")
  @@map("client_service_rate_limit_windows")
}

model AdminAuditLog {
  id String @id(map: "admin_audit_logs_pkey") @default(cuid())

  clientServiceId String?        @map("client_service_id")
  clientService   ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull, map: "admin_audit_logs_client_service_id_fkey")
  actor           String
  requestId       String         @map("request_id")
  action          String
  targetType      String         @map("target_type")
  targetId        String         @map("target_id")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([clientServiceId, createdAt], map: "admin_audit_logs_client_service_created_at_idx")
  @@index([actor, createdAt], map: "admin_audit_logs_actor_created_at_idx")
  @@index([requestId], map: "admin_audit_logs_request_id_idx")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "admin_audit_logs_created_at_id_idx")
  @@map("admin_audit_logs")
}

model ClientServiceLifecycleSubscription {
  id              String        @id(map: "client_service_lifecycle_subscriptions_pkey") @default(cuid())
  clientServiceId String        @map("client_service_id")
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade, map: "client_service_lifecycle_subscriptions_client_service_id_fkey")

  eventType          String    @map("event_type")
  consumerGroup      String    @map("consumer_group")
  isEnabled          Boolean   @default(true) @map("is_enabled")
  description        String?
  topic              String    @map("topic")
  principal          String    @map("principal")
  provisioningStatus String    @default("PENDING") @map("provisioning_status")
  provisioningError  String?   @map("provisioning_error")
  provisionedAt      DateTime? @map("provisioned_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientServiceId, eventType, consumerGroup], map: "client_service_lifecycle_subscriptions_service_event_group_key")
  @@index([clientServiceId], map: "client_service_lifecycle_subscriptions_client_service_id_idx")
  @@index([eventType], map: "client_service_lifecycle_subscriptions_event_type_idx")
  @@index([consumerGroup], map: "client_service_lifecycle_subscriptions_consumer_group_idx")
  @@index([isEnabled], map: "client_service_lifecycle_subscriptions_is_enabled_idx")
  @@index([topic], map: "client_service_lifecycle_subscriptions_topic_idx")
  @@index([provisioningStatus], map: "client_service_lifecycle_subscriptions_provisioning_status_idx")
  @@map("client_service_lifecycle_subscriptions")
}

model ClientServiceImageResizePolicy {
  id              String        @id(map: "client_service_image_resize_policies_pkey") @default(cuid())
  clientServiceId String        @unique(map: "client_service_image_resize_policies_client_service_id_key") @map("client_service_id")
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade, map: "client_service_image_resize_policies_client_service_id_fkey")

  mode String @default("ON_DEMAND")

  variants ClientServiceImageResizeVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([mode], map: "client_service_image_resize_policies_mode_idx")
  @@map("client_service_image_resize_policies")
}

model ClientServiceImageResizeVariant {
  id       String                         @id(map: "client_service_image_resize_variants_pkey") @default(cuid())
  policyId String                         @map("policy_id")
  policy   ClientServiceImageResizePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade, map: "client_service_image_resize_variants_policy_id_fkey")

  width       Int?
  height      Int?
  format      String
  isEnabled   Boolean @default(true) @map("is_enabled")
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([policyId, width, height, format], map: "client_service_image_resize_variants_policy_size_format_key")
  @@index([policyId], map: "client_service_image_resize_variants_policy_id_idx")
  @@index([format], map: "client_service_image_resize_variants_format_idx")
  @@index([isEnabled], map: "client_service_image_resize_variants_is_enabled_idx")
  @@map("client_service_image_resize_variants")
}

enum ImageAssetState {
  Pending
  Ready
  Deleting
  Deleted
  Failed
}

enum ImageVariantState {
  Pending
  Ready
  Deleting
  Deleted
  Failed
}

enum ImageVariantJobState {
  Pending
  Processing
  Completed
  Failed
  Cancelled
}

model ImageAsset {
  assetId         String        @id(map: "image_assets_pkey") @default(cuid()) @map("asset_id")
  clientServiceId String        @map("client_service_id")
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Restrict, map: "image_assets_client_service_id_fkey")

  idempotencyKey  String          @map("idempotency_key")
  sourceEventId   String?         @unique(map: "image_assets_source_event_id_key") @map("source_event_id")
  deleteEventId   String?         @unique(map: "image_assets_delete_event_id_key") @map("delete_event_id")
  externalImageId Int?            @map("external_image_id")
  logicalPath     String          @map("logical_path")
  name            String
  originalName    String          @map("original_name")
  storageKey      String          @unique(map: "image_assets_storage_key_key") @map("storage_key")
  contentType     String          @map("content_type")
  inputBytes      Int?            @map("input_bytes")
  bytes           Int?
  checksum        String?
  width           Int?
  height          Int?
  format          String?
  status          ImageAssetState @default(Pending)
  failureReason   String?         @map("failure_reason")
  cacheVersion    Int             @default(1) @map("cache_version")

  readyAt          DateTime? @map("ready_at")
  deletingAt       DateTime? @map("deleting_at")
  deletedAt        DateTime? @map("deleted_at")
  failedAt         DateTime? @map("failed_at")
  lastReconciledAt DateTime? @map("last_reconciled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  variants    ImageVariant[]
  variantJobs ImageVariantJob[]

  @@unique([clientServiceId, idempotencyKey], map: "image_assets_owner_idempotency_key")
  @@unique([clientServiceId, logicalPath, name], map: "image_assets_owner_path_name_key")
  @@index([clientServiceId, status, createdAt], map: "image_assets_owner_state_created_idx")
  @@index([status, updatedAt], map: "image_assets_reconciliation_idx")
  @@index([status, lastReconciledAt, assetId], map: "image_assets_ready_reconciliation_idx")
  @@index([status, lastReconciledAt, updatedAt, assetId], map: "image_assets_ready_unreconciled_idx")
  @@index([status, deletedAt, assetId], map: "image_assets_deleted_cleanup_idx")
  @@map("image_assets")
}

model ImageVariant {
  variantId String     @id(map: "image_variants_pkey") @default(cuid()) @map("variant_id")
  assetId   String     @map("asset_id")
  asset     ImageAsset @relation(fields: [assetId], references: [assetId], onDelete: Cascade, map: "image_variants_asset_id_fkey")

  specKey        String            @map("spec_key")
  storageKey     String            @unique(map: "image_variants_storage_key_key") @map("storage_key")
  width          Int?
  height         Int?
  format         String
  sourceChecksum String            @map("source_checksum")
  bytes          Int?
  checksum       String?
  status         ImageVariantState @default(Pending)
  failureReason  String?           @map("failure_reason")
  readyAt        DateTime?         @map("ready_at")
  deletingAt     DateTime?         @map("deleting_at")
  deletedAt      DateTime?         @map("deleted_at")
  failedAt       DateTime?         @map("failed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  jobs ImageVariantJob[]

  @@unique([assetId, specKey], map: "image_variants_asset_spec_key")
  @@index([assetId, status], map: "image_variants_asset_state_idx")
  @@index([status, updatedAt], map: "image_variants_reconciliation_idx")
  @@index([status, deletedAt, variantId], map: "image_variants_deleted_cleanup_idx")
  @@map("image_variants")
}

model ImageVariantJob {
  jobId     String       @id(map: "image_variant_jobs_pkey") @default(cuid()) @map("job_id")
  assetId   String       @map("asset_id")
  asset     ImageAsset   @relation(fields: [assetId], references: [assetId], onDelete: Cascade, map: "image_variant_jobs_asset_id_fkey")
  variantId String       @map("variant_id")
  variant   ImageVariant @relation(fields: [variantId], references: [variantId], onDelete: Cascade, map: "image_variant_jobs_variant_id_fkey")

  jobKey           String               @unique(map: "image_variant_jobs_job_key_key") @map("job_key")
  status           ImageVariantJobState @default(Pending)
  attempts         Int                  @default(0)
  nextAttemptAt    DateTime             @default(now()) @map("next_attempt_at")
  leaseOwner       String?              @map("lease_owner")
  leaseExpiresAt   DateTime?            @map("lease_expires_at")
  lastError        String?              @map("last_error")
  completedAt      DateTime?            @map("completed_at")
  publishedAt      DateTime?            @map("published_at")
  publishAttempts  Int                  @default(0) @map("publish_attempts")
  nextPublishAt    DateTime             @default(now()) @map("next_publish_at")
  publishLastError String?              @map("publish_last_error")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt, leaseExpiresAt], map: "image_variant_jobs_claim_idx")
  @@index([assetId, status], map: "image_variant_jobs_asset_state_idx")
  @@index([publishedAt, nextPublishAt], map: "image_variant_jobs_publish_idx")
  @@map("image_variant_jobs")
}

model ImageReconciliationLease {
  leaseName String   @id(map: "image_reconciliation_leases_pkey") @map("lease_name")
  owner     String
  token     String   @unique(map: "image_reconciliation_leases_token_key")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt], map: "image_reconciliation_leases_expires_at_idx")
  @@map("image_reconciliation_leases")
}

model ImageReconciliationMetric {
  id                  String    @id(map: "image_reconciliation_metrics_pkey")
  orphanCount         Int       @default(0) @map("orphan_count")
  repairedCount       Int       @default(0) @map("repaired_count")
  failedCount         Int       @default(0) @map("failed_count")
  oldestPendingAgeMs  Float?    @map("oldest_pending_age_ms")
  oldestDeletingAgeMs Float?    @map("oldest_deleting_age_ms")
  durationMs          Int       @default(0) @map("duration_ms")
  lastRunAt           DateTime? @map("last_run_at")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastError           String?   @map("last_error")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("image_reconciliation_metrics")
}

model TelemetryEvent {
  id          String @id(map: "telemetry_events_pkey") @default(cuid())
  eventId     String @unique(map: "telemetry_events_event_id_key") @map("event_id")
  eventType   String @map("event_type")
  sourceApp   String @map("source_app")
  environment String
  status      String

  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  clientServiceId   String?        @map("client_service_id")
  clientServiceSlug String?        @map("client_service_slug")
  clientService     ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull, map: "telemetry_events_client_service_id_fkey")

  requestId String? @map("request_id")
  traceId   String? @map("trace_id")

  imageId  Int?    @map("image_id")
  path     String
  name     String
  imageKey String  @map("image_key")
  cacheKey String? @map("cache_key")

  width       Int?
  height      Int?
  format      String?
  inputBytes  Int?    @map("input_bytes")
  outputBytes Int?    @map("output_bytes")
  durationMs  Float?  @map("duration_ms")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  rawPayload   Json    @map("raw_payload")

  @@index([clientServiceId, occurredAt], map: "telemetry_events_client_service_id_occurred_at_idx")
  @@index([clientServiceSlug, occurredAt], map: "telemetry_events_client_service_slug_occurred_at_idx")
  @@index([eventType, occurredAt], map: "telemetry_events_event_type_occurred_at_idx")
  @@index([sourceApp, occurredAt], map: "telemetry_events_source_app_occurred_at_idx")
  @@index([status, occurredAt], map: "telemetry_events_status_occurred_at_idx")
  @@index([imageKey, occurredAt], map: "telemetry_events_image_key_occurred_at_idx")
  @@index([requestId], map: "telemetry_events_request_id_idx")
  @@index([traceId], map: "telemetry_events_trace_id_idx")
  @@index([occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_occurred_at_event_id_idx")
  @@index([clientServiceId, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_client_service_occurred_event_idx")
  @@index([clientServiceSlug, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_client_slug_occurred_event_idx")
  @@index([eventType, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_event_type_occurred_event_idx")
  @@index([sourceApp, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_source_app_occurred_event_idx")
  @@index([status, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_status_occurred_event_idx")
  @@index([imageKey, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_image_key_occurred_event_idx")
  @@index([eventType, status, clientServiceId, imageKey, occurredAt(sort: Desc), eventId(sort: Desc)], map: "telemetry_events_image_asset_backfill_idx")
  @@index([occurredAt, id], map: "telemetry_events_retention_occurred_at_id_idx")
  @@map("telemetry_events")
}

model ImageLifecycleEvent {
  id          String @id(map: "image_lifecycle_events_pkey") @default(cuid())
  eventId     String @unique(map: "image_lifecycle_events_event_id_key") @map("event_id")
  eventType   String @map("event_type")
  sourceApp   String @map("source_app")
  environment String
  status      String

  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  clientServiceId   String?        @map("client_service_id")
  clientServiceSlug String?        @map("client_service_slug")
  clientService     ClientService? @relation(fields: [clientServiceId], references: [id], onDelete: SetNull, map: "image_lifecycle_events_client_service_id_fkey")

  requestId String? @map("request_id")
  traceId   String? @map("trace_id")

  imageId  Int?   @map("image_id")
  path     String
  name     String
  imageKey String @map("image_key")

  format      String?
  inputBytes  Int?    @map("input_bytes")
  outputBytes Int?    @map("output_bytes")
  durationMs  Float?  @map("duration_ms")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  rawPayload   Json    @map("raw_payload")

  @@index([clientServiceId, occurredAt], map: "image_lifecycle_events_client_service_id_occurred_at_idx")
  @@index([clientServiceSlug, occurredAt], map: "image_lifecycle_events_client_service_slug_occurred_at_idx")
  @@index([eventType, occurredAt], map: "image_lifecycle_events_event_type_occurred_at_idx")
  @@index([status, occurredAt], map: "image_lifecycle_events_status_occurred_at_idx")
  @@index([imageKey, occurredAt], map: "image_lifecycle_events_image_key_occurred_at_idx")
  @@index([requestId], map: "image_lifecycle_events_request_id_idx")
  @@index([traceId], map: "image_lifecycle_events_trace_id_idx")
  @@index([occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_occurred_at_event_id_idx")
  @@index([clientServiceId, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_client_service_occurred_event_idx")
  @@index([clientServiceSlug, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_client_slug_occurred_event_idx")
  @@index([eventType, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_event_type_occurred_event_idx")
  @@index([sourceApp, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_source_app_occurred_event_idx")
  @@index([status, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_status_occurred_event_idx")
  @@index([imageKey, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_image_key_occurred_event_idx")
  @@index([eventType, status, clientServiceId, imageKey, occurredAt(sort: Desc), eventId(sort: Desc)], map: "image_lifecycle_events_image_asset_backfill_idx")
  @@index([occurredAt, id], map: "image_lifecycle_events_retention_occurred_at_id_idx")
  @@map("image_lifecycle_events")
}

model ImageLifecycleIngestionMetric {
  id                     String    @id(map: "image_lifecycle_ingestion_metrics_pkey")
  validationFailureCount Int       @default(0) @map("validation_failure_count")
  insertFailureCount     Int       @default(0) @map("insert_failure_count")
  lastConsumedEventAt    DateTime? @map("last_consumed_event_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("image_lifecycle_ingestion_metrics")
}

model ImageLifecycleOutbox {
  id             String    @id(map: "image_lifecycle_outbox_pkey") @default(cuid())
  eventId        String    @map("event_id")
  topic          String
  kafkaKey       String    @map("kafka_key")
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  publishedAt    DateTime? @map("published_at")
  deadLetteredAt DateTime? @map("dead_lettered_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, topic], map: "image_lifecycle_outbox_event_id_topic_key")
  @@index([status, nextAttemptAt, leaseExpiresAt], map: "image_lifecycle_outbox_claim_idx")
  @@index([status, publishedAt], map: "image_lifecycle_outbox_published_retention_idx")
  @@index([status, deadLetteredAt], map: "image_lifecycle_outbox_dead_letter_retention_idx")
  @@index([createdAt], map: "image_lifecycle_outbox_created_at_idx")
  @@map("image_lifecycle_outbox")
}

model TelemetryIngestionMetric {
  id                     String    @id(map: "telemetry_ingestion_metrics_pkey")
  validationFailureCount Int       @default(0) @map("validation_failure_count")
  insertFailureCount     Int       @default(0) @map("insert_failure_count")
  lastConsumedEventAt    DateTime? @map("last_consumed_event_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("telemetry_ingestion_metrics")
}
